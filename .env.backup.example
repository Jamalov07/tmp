# ─── Database Backup (host PostgreSQL + PM2, no Docker) ──────────────────────
# Asosiy ulanish: .env dagi DATABASE_URL
# Ixtiyoriy override: DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
#
# PROJECT_NAME — root papka nomidan (tmp)
# Retention: local 7 / remote 30 (static)

# PM2 process nomi (restore paytida stop/start). Default = papka nomi
# PM2_APP_NAME=tmp

# Lokal backup / log
# BACKUP_DIR=/var/backups/tmp
# LOG_DIR=/var/log/tmp

# rclone
RCLONE_REMOTE=gdrive:tmp/backups
RCLONE_ENABLED=true

MIN_FREE_MB=500

# Telegram
TELEGRAM_ENABLED=true
BACKUP_CHANNEL_ID=-100xxxxxxxxx

# Cron
# CRON_SCHEDULE=0 2 * * *
# CRON_LOG=/path/to/logs/cron-backup.log
